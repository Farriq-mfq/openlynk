# copy ke .env
PORT=3001
# pisahkan dengan koma jika lebih dari satu
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
# alamat publik API untuk browser (dipakai untuk URL file upload).
# samakan dengan alamat API yang diakses browser (mis. di production: https://api.example.com)
API_PUBLIC_URL=http://localhost:3001
# koneksi postgres lokal (dev); di compose gunakan host `postgres`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openlynk
# rahasia JWT (wajib di production) + salt harian analytics
JWT_SECRET=
ANALYTICS_SALT=

# copy ke .env
PORT=3001
# pisahkan dengan koma jika lebih dari satu
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
# koneksi postgres lokal (dev); di compose gunakan host `postgres`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openlynk
# rahasia JWT (wajib di production) + salt harian analytics
JWT_SECRET=
ANALYTICS_SALT=
# akun admin awal — dibuat via `bun run db:seed` (idempoten, tidak menimpa admin lama).
# Seeder juga membuat profil publik minimal bila belum ada (butuh username unik).
# JANGAN pakai nilai contoh ini di production. Password tidak pernah dicetak ke log.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin

# copy ke .env, lalu ganti semua nilai change-me sebelum `docker compose up`
# generate secret:  openssl rand -base64 32

# --- postgres ---
POSTGRES_USER=openlynk
# URL-encode karakter khusus (& @ / : ? #) karena dipakai di dalam DATABASE_URL
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openlynk

# --- port host (di dalam container selalu 3001/3000) ---
API_PORT=3001
WEB_PORT=3000

# --- api ---
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
ANALYTICS_SALT=change-me
# asal browser yang diizinkan (koma bila >1). Production: https://example.com
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
# alamat API menurut browser — dipakai untuk URL file upload.
# Production: https://api.example.com (atau domain yang sama bila di-proxy)
API_PUBLIC_URL=http://localhost:3001

# --- web ---
# alamat API menurut browser. Production: samakan dengan API_PUBLIC_URL.
NUXT_PUBLIC_API_BASE=http://localhost:3001
